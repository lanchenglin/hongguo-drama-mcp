{
  "name": "hongguo-downloader",
  "version": "1.73.0-lan.2",
  "description": "红果短剧播放与下载",
  "main": "main.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run build:react && electron-builder --win --x64 --publish never",
    "build:zip": "npm run build:react && electron-builder --win --x64 --publish never --dir && node scripts/make-zip.js",
    "build:dir": "npm run build:react && electron-builder --win --x64 --publish never --dir",
    "build:portable": "npm run build:react && electron-builder --win portable --x64 --publish never",
    "build:installer": "npm run build:react && electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --dir",
    "zip": "node scripts/make-zip.js",
    "setup:ffmpeg:mac": "node scripts/setup-ffmpeg-mac.js",
    "build:mac": "node scripts/setup-ffmpeg-mac.js arm64 x64 && npm run build:react && electron-builder --mac dmg --arm64 --x64 --publish never",
    "build:mac:dir": "node scripts/setup-ffmpeg-mac.js arm64 x64 && npm run build:react && electron-builder --mac --arm64 --x64 --dir --publish never",
    "test:lan": "node --test tests/remote-control.test.cjs"
  },
  "dependencies": {
    "anime4k-webgpu": "1.0.0",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "io.github.jackotom.hongguo-drama-mac",
    "productName": "红果短剧",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*",
      "src/native/**/*",
      "src/store.js"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe",
            "WINDOWS-*.txt",
            "COPYING.*",
            "LICENSE.md"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "红果短剧下载器",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "build/ffmpeg/darwin-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "COPYING.*",
            "LICENSE.md",
            "MACOS-*.txt"
          ]
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ],
      "binaries": [
        "Contents/Resources/bin/ffmpeg",
        "Contents/Resources/bin/ffprobe"
      ]
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
